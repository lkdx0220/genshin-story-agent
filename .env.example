# 原神剧情助手环境变量示例
# 复制为 .env 并填写真实值；.env 不要提交/不要打进 exe。

# DashScope/Qwen 相关
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_FALLBACK_API_KEY=
DASHSCOPE_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 相关
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Web API 访问令牌（可选）
# 不配置：仅本机可访问 /api/*
# 配置后：远程访问需请求头 Authorization: Bearer <API_TOKEN>
API_TOKEN=
